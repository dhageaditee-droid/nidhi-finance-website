# Nidhi Finance Admin Authentication Credentials
# Set these environment variables in your Vercel Project Dashboard (Settings > Environment Variables)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Client-side fallbacks (optional)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your_secure_password_here

# Cloud Database Configuration (Optional Supabase integration)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
